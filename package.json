{
  "name": "@myseer/balanceamento",
  "version": "0.1.0",
  "description": "IRIS - Agente de IA para balanceamento de estoque entre lojas",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:tracking": "tsx scripts/setup-usage-tracking.ts",
    "setup:logging": "tsx scripts/setup-agents-log.ts",
    "setup:rules": "tsx scripts/setup-rules-system.ts",
    "setup:knowledge": "tsx scripts/setup-knowledge-base.ts"
  },
  "keywords": [
    "balanceamento",
    "estoque",
    "ia",
    "clickhouse",
    "mcp"
  ],
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@clickhouse/client": "^1.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^4.21.0",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
